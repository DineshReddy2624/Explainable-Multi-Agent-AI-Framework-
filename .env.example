# Production Environment Variables Template
ENVIRONMENT=production
SECRET_KEY=CHANGE_THIS_TO_A_64_CHAR_RANDOM_HEX_KEY_FOR_PRODUCTION
LOG_LEVEL=INFO

# Database Connection (PostgreSQL for Production)
DATABASE_URL=postgresql://postgres:postgres_password_123@localhost:5432/data_quality_db

# Redis & Celery Infrastructure
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# File Limits & Storage
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=./uploads
CLEANED_DIR=./cleaned_datasets

# Concurrency & Performance Tuning
CELERY_WORKER_CONCURRENCY=4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Optional Generative AI Integration
# GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback
